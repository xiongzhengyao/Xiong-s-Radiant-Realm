{
  "name": "personal-feed",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build": "node scripts/generate-feeds.js && vite build",
    "serve": "vite preview --port 8890 --host 127.0.0.1",
    "start": "node server.js",
    "new:post": "node scripts/new-post.js",
    "deploy:remote": "bash scripts/deploy-remote.sh",
    "rollback:remote": "bash scripts/rollback-remote.sh",
    "release:local": "npm run build && launchctl kickstart -k gui/$(id -u)/com.snowhush.site",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{js,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,json,css,scss,md}\""
  },
  "dependencies": {
    "element-plus": "^2.4.0",
    "express": "^4.18.2",
    "markdown-it": "^14.1.0",
    "markdown-it-table": "^4.1.1",
    "pinia": "^3.0.1",
    "vue": "^3.3.0",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "prettier": "^3.2.5",
    "vite": "^4.5.0"
  }
}
